{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "The Valley Indian",
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "740px",
      "wideSize": "1240px",
      "useRootPaddingAwareAlignments": false
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#183c39",
          "name": "Ink (Primary)"
        },
        {
          "slug": "ink-hover",
          "color": "#285b54",
          "name": "Ink Hover"
        },
        {
          "slug": "paper",
          "color": "#f8f6ef",
          "name": "Paper (Background)"
        },
        {
          "slug": "muted",
          "color": "#63706a",
          "name": "Muted Slate"
        },
        {
          "slug": "orange",
          "color": "#ba4c2c",
          "name": "Terracotta Orange"
        },
        {
          "slug": "line",
          "color": "#d9ddd3",
          "name": "Line Border"
        },
        {
          "slug": "gold",
          "color": "#e5b876",
          "name": "Gold Accent"
        },
        {
          "slug": "card-bg",
          "color": "#fffdf7",
          "name": "Card Background"
        },
        {
          "slug": "sponsor-bg",
          "color": "#ecebdf",
          "name": "Sponsor Background"
        },
        {
          "slug": "notice-bg",
          "color": "#efe7d3",
          "name": "Notice Background"
        },
        {
          "slug": "tag-bg",
          "color": "#ede2cb",
          "name": "Tag Background"
        },
        {
          "slug": "review-bg",
          "color": "#eef0e7",
          "name": "Review Background"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ],
      "gradients": [
        {
          "slug": "editorial-sunrise",
          "gradient": "linear-gradient(155deg, #e8c98f 0%, #cb986d 40%, #668477 41%, #315d52 68%, #183c39 69%)",
          "name": "Editorial Sunrise"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "Georgia, 'Times New Roman', Times, serif",
          "name": "Serif (Georgia)",
          "slug": "serif"
        },
        {
          "fontFamily": "Arial, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Sans-serif (Arial)",
          "slug": "sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "seal-sub",
          "size": "7px",
          "name": "Seal Subtitle"
        },
        {
          "slug": "caption",
          "size": "8px",
          "name": "Art Caption"
        },
        {
          "slug": "eyebrow",
          "size": "10px",
          "name": "Eyebrow & Topline"
        },
        {
          "slug": "small",
          "size": "11px",
          "name": "Small / Footer"
        },
        {
          "slug": "btn",
          "size": "12px",
          "name": "Button & Nav"
        },
        {
          "slug": "body-small",
          "size": "13px",
          "name": "Card Body & Notice"
        },
        {
          "slug": "medium",
          "size": "15px",
          "name": "Body (Base)"
        },
        {
          "slug": "large",
          "size": "23px",
          "name": "Large (H3)"
        },
        {
          "slug": "x-large",
          "size": "27px",
          "name": "Extra Large (H2)"
        },
        {
          "slug": "xx-large",
          "size": "43px",
          "name": "Huge (H1)"
        },
        {
          "slug": "masthead",
          "size": "48px",
          "name": "Masthead Brand"
        }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": false,
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vh",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans-serif)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--orange)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "400",
          "lineHeight": "1.13"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "letterSpacing": "-1px"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "width": "1px",
          "style": "solid",
          "color": "var(--wp--preset--color--ink)",
          "radius": "3px"
        },
        "spacing": {
          "padding": {
            "top": "9px",
            "bottom": "9px",
            "left": "15px",
            "right": "15px"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans-serif)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "normal"
        }
      }
    },
    "blocks": {
      "core/separator": {
        "border": {
          "color": "var(--wp--preset--color--line)",
          "style": "solid",
          "width": "1px"
        }
      },
      "core/post-template": {
        "spacing": {
          "margin": {
            "top": "0px",
            "bottom": "0px"
          },
          "padding": {
            "top": "0px",
            "bottom": "0px"
          }
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--eyebrow)",
          "letterSpacing": "1.3px",
          "textTransform": "uppercase",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--orange)"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "400"
        },
        "spacing": {
          "margin": {
            "top": "0px",
            "bottom": "10px"
          }
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--ink)"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--body-small)",
          "lineHeight": "1.5"
        },
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "spacing": {
          "margin": {
            "top": "0px",
            "bottom": "14px"
          }
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--orange)"
            },
            "typography": {
              "fontWeight": "700",
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--btn)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--ink)"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--orange)"
              }
            }
          }
        }
      },
      "core/template-part": {
        "spacing": {
          "margin": {
            "top": "0px",
            "bottom": "0px"
          },
          "padding": {
            "left": "32px",
            "right": "32px"
          }
        }
      }
    },
    "spacing": {
      "blockGap": "0px"
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-submit",
      "title": "Submit a Story",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-desk",
      "title": "The Editor's Desk",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-clark-county",
      "title": "Clark County Stories",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-across-america",
      "title": "Across America Coverage",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-standards",
      "title": "Editorial Standards",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-advertise",
      "title": "Partner / Advertising",
      "postTypes": [
        "page"
      ]
    }
  ]
}