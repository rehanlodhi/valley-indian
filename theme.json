{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Vegas Indian Pulse",
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "740px",
      "wideSize": "1280px",
      "useRootPaddingAwareAlignments": false
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#111b25",
          "name": "Ink (Primary Text)"
        },
        {
          "slug": "dark",
          "color": "#060b14",
          "name": "Midnight Charcoal"
        },
        {
          "slug": "paper",
          "color": "#faf7ef",
          "name": "Cream (Canvas)"
        },
        {
          "slug": "gold",
          "color": "#edba46",
          "name": "Saffron Gold"
        },
        {
          "slug": "saffron",
          "color": "#ce580b",
          "name": "Deep Saffron"
        },
        {
          "slug": "teal",
          "color": "#007b70",
          "name": "Civic Teal"
        },
        {
          "slug": "line",
          "color": "#ded9ce",
          "name": "Hairline Border"
        },
        {
          "slug": "muted",
          "color": "#606767",
          "name": "Muted Slate"
        },
        {
          "slug": "card-bg",
          "color": "#fffdf8",
          "name": "Card Surface"
        },
        {
          "slug": "sponsor-bg",
          "color": "#efe6cd",
          "name": "Ad Banner Surface"
        },
        {
          "slug": "ad-slot-bg",
          "color": "#f3eedf",
          "name": "Ad Slot Surface"
        },
        {
          "slug": "notice-bg",
          "color": "#edf2ef",
          "name": "Notice Surface"
        },
        {
          "slug": "tag-bg",
          "color": "#f4e6c1",
          "name": "Tag Surface"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ],
      "gradients": []
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "Georgia, 'Times New Roman', Times, serif",
          "name": "Serif (Georgia)",
          "slug": "serif"
        },
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Sans-serif (System UI)",
          "slug": "sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "tag",
          "size": "10px",
          "name": "Tag Pill"
        },
        {
          "slug": "eyebrow",
          "size": "11px",
          "name": "Eyebrow & Topline"
        },
        {
          "slug": "small",
          "size": "12px",
          "name": "Small / Meta"
        },
        {
          "slug": "btn",
          "size": "13px",
          "name": "Header Button"
        },
        {
          "slug": "body-small",
          "size": "14px",
          "name": "Nav & Card Body"
        },
        {
          "slug": "medium",
          "size": "16px",
          "name": "Body (Base)"
        },
        {
          "slug": "large",
          "size": "25px",
          "name": "Large (H3)"
        },
        {
          "slug": "x-large",
          "size": "30px",
          "name": "Extra Large (H2)"
        },
        {
          "slug": "xx-large",
          "size": "clamp(32px, 4.3vw, 58px)",
          "name": "Huge (H1)"
        }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": false,
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vh",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans-serif)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "500",
          "lineHeight": "1.15"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "letterSpacing": "normal"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--teal)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "width": "1px",
          "style": "solid",
          "color": "var(--wp--preset--color--teal)",
          "radius": "5px"
        },
        "spacing": {
          "padding": {
            "top": "10px",
            "bottom": "10px",
            "left": "17px",
            "right": "17px"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans-serif)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "600",
          "lineHeight": "1.6"
        }
      }
    },
    "blocks": {
      "core/separator": {
        "border": {
          "color": "var(--wp--preset--color--line)",
          "style": "solid",
          "width": "1px"
        }
      },
      "core/post-template": {
        "spacing": {
          "margin": {
            "top": "0px",
            "bottom": "0px"
          },
          "padding": {
            "top": "0px",
            "bottom": "0px"
          }
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--eyebrow)",
          "letterSpacing": "1.6px",
          "textTransform": "uppercase",
          "fontWeight": "750"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--teal)"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "500",
          "lineHeight": "1.15"
        },
        "elements": {
          "link": {
            "color": {
              "text": "inherit"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--teal)"
            },
            "typography": {
              "fontWeight": "700",
              "textDecoration": "none"
            }
          }
        }
      },
      "core/template-part": {
        "spacing": {
          "margin": {
            "top": "0px",
            "bottom": "0px"
          },
          "padding": {
            "top": "0px",
            "bottom": "0px",
            "left": "0px",
            "right": "0px"
          }
        }
      }
    },
    "spacing": {
      "blockGap": "0px"
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
